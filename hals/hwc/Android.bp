cc_binary {
    name: "android.hardware.composer.hwc3-service.drm.xt",

    overrides: ["com.android.hardware.graphics.composer.ranchu"],

    srcs: [
        ":drm_hwcomposer_hwc3",
        ":drm_hwcomposer_service",
        ":drm_hwcomposer_common",
        ":drm_hwcomposer_platformimagination",
    ],

    include_dirs: [
        "device/epam/aosp-xenvm-trout/hals/hwc/include",
    ],

    defaults: [
        "hwcomposer.drm_defaults",
    ],

    shared_libs: [
        "android.hardware.graphics.composer3-V3-ndk",
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],

    cflags: [
        "-Wall",
        "-Werror",

        "-DUSE_IMAPPER4_METADATA_API",
    ],

    cppflags: [
        "-DHWC2_INCLUDE_STRINGIFICATION",
        "-DHWC2_USE_CPP11",
        "-DENABLE_GEM_HANDLE_CACHING",
    ],

    relative_install_path: "hw",
    vendor: true,

    vintf_fragments: [":drm_hwcomposer_vintf_manifest"],
    init_rc: ["hwc3-drm-xt.rc"],
}
