service dispfw_fe /system/bin/sh /vendor/bin/dfw.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0

on early-init
    start dispfw_fe


on property:sys.boot_completed=1
    stop seriallogging

on property:init.svc.vendor.hwcomposer-3=running
    wait_for_prop init.svc.vendor.hwcomposer-3 running
    wait /dev/video3
    start android.hardware.automotive.evs-default
    wait_for_prop init.svc.android.hardware.automotive.evs-default running
    start evsmanagerd
    start evs_app

