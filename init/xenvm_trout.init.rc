service dispfw_fe /vendor/bin/dfw.sh
    user root
    group root
    oneshot
    disabled

on early-init
    start dispfw_fe

on property:apex.all.ready=true && property:vendor.dfw.display_ready=1
    restart vendor.hwcomposer-3

on property:sys.boot_completed=1
    stop seriallogging

on property:init.svc.vendor.hwcomposer-3=running
    wait_for_prop init.svc.vendor.hwcomposer-3 running
    wait /dev/video3
    start android.hardware.automotive.evs-default
    wait_for_prop init.svc.android.hardware.automotive.evs-default running
    start evsmanagerd
    start evs_app

on fs
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/tee 0770 root system

service tee-supplicant /vendor/bin/tee-supplicant
    class early_hal
    user root
    group root system
