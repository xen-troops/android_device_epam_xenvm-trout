service dispfw_fe /vendor/bin/dfw.sh
    user root
    group root
    oneshot
    disabled

on early-init
    start dispfw_fe

on property:apex.all.ready=true && property:vendor.dfw.display_ready=1
    restart vendor.hwcomposer-3

service seriallogging /system/bin/logcat -b all -v threadtime -f /dev/vport2p6 *:V
    class main
    user logd
    group root logd
    seclabel u:r:logpersist:s0
    override

service tee-supplicant /vendor/bin/tee-supplicant
    class early_hal
    user root
    group root system
