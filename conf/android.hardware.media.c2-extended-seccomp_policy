# Extended seccomp policy for V4L2 Codec2 service.
# Allow socket option configuration used by encoder path.
_llseek: 1
epoll_create1: 1
epoll_ctl: 1
epoll_pwait: 1
eventfd2: 1
fstat64: 1
fstatat64: 1
fstatfs64: 1
getcwd: 1
getdents64: 1
getuid32: 1
mmap2: 1
pselect6: 1
statfs64: 1
setsockopt: 1
sysinfo: 1
ugetrlimit: 1
 
# Required for standard Android Binder (ProcessState thread pool)
ioctl: 1
futex: 1
mprotect: 1
clone: 1
 
# Required for AIDL binder (gralloc IAllocator) linkToDeath / RPC socket setup
bind: 1
socket: 1
connect: 1
sendmsg: 1
getsockname: 1
listen: 1
recvmsg: 1
shutdown: 1