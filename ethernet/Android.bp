sh_binary {
    name: "auto_ethernet_setup_script_xenvm",
    src: "ethernet_sys_ns.sh",
    sub_dir: "ethernet",
    system_ext_specific: true,
    filename_from_src: true,
    init_rc: ["ethernet-xt.rc"],
    visibility: [
        "//device:__subpackages__",
    ],
}

sh_binary {
    name: "auto_ethernet_config_script_xenvm",
    src: "ethernet_auto_eth_ns.sh",
    sub_dir: "ethernet",
    system_ext_specific: true,
    filename_from_src: true,
    init_rc: ["ethernet-xt.rc"],
    visibility: [
        "//device:__subpackages__",
    ],
}
