# Start and restart after netd
on property:init.svc.netd=running
    setprop vendor.sys_ns.ready 0
    restart sys-ns-ethernet-setup

on property:init.svc.netd=restarting
    setprop vendor.sys_ns.ready 0
    restart sys-ns-ethernet-setup

# auto_eth тільки після sys_ns
on property:vendor.sys_ns.ready=1
    restart auto_eth-ns-ethernet-setup


# Set up the main ethernet ip address and routing
# Create network namespace auto_eth
service sys-ns-ethernet-setup /system_ext/bin/ethernet/ethernet_sys_ns.sh
    class core
    user root
    group shell
    oneshot
    disabled

# Set up routing rule for network namespace auto_eth
service auto_eth-ns-ethernet-setup /system_ext/bin/ethernet/ethernet_auto_eth_ns.sh
    enter_namespace net /mnt/run/auto_eth
    class core
    user root
    group shell
    oneshot
    disabled